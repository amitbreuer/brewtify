# Disabled by default; no production values or credentials belong in this file.
PARTY_ENABLED=false
PARTY_PUBLIC_ORIGIN=https://YOUR-TEST-SERVICE.run.app
PARTY_SPOTIFY_REDIRECT_URI=https://YOUR-TEST-SERVICE.run.app/api/party/auth/callback
PARTY_TELEGRAM_BOT_USERNAME=YOUR_TEST_BOT
# Independent 32-byte hex HMAC key; store in Secret Manager.
PARTY_IDENTITY_KEY=
# Apple Music song links use free iTunes Store lookup; no Apple credentials.
PARTY_TASKS_PROJECT=
PARTY_TASKS_LOCATION=
PARTY_TASKS_QUEUE=brewtify-party
PARTY_TASKS_SERVICE_ACCOUNT=
PARTY_TASKS_AUDIENCE=https://YOUR-TEST-SERVICE.run.app
